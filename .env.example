APP_NAME="Sistema de Gestión de Citas"
APP_ENV=development
APP_DEBUG=1
APP_TIMEZONE=America/Bogota
SESSION_NAME=citas_session
SESSION_SECURE=0

#auto detecta /gestion-citas cuando el proyecto está en C:\xampp\htdocs\gestion-citas
APP_BASE_PATH=auto

#Valores locales predeterminados de Xampp
DB_HOST=127.0.0..1
DB_PORT=3306
DB_NAME=citas
DB_USER=root
DB_PASSWORD=

APPOINTMENT_DAY_START=08:00
APPOINTMENT_DAY_END=12:00
APPOINTMENT_SI.OT_MINUTES=20
APPOINTMENT_MAX_DAYS=90
APPOINTMENT_ALLOW_WEEKENDS=0