{
    "name": "formacion/gestion-citas",
    "description": "Aplicación educativa para gestionar pacientes y citas odontológicas con PHP 8.",
    "type": "project",
    "license": "MIT",
    "require": {
    "php": "^8.2",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*"
    },
    "require-dev": {
    "phpunit/phpunit": "^11.5"
    },
    "autoload": {
    "psr-4": {
    "App\\": "src/"
    },
    "files": [
    "src/Support/helpers.php"
    ]
    },
    "autoload-dev": {
    "psr-4": {
    "Tests\\": "tests/"
    }
    },
    "scripts": {
    "serve": "php -S 127.0.0.1:8080 -t public public/router.php",
    "check": "php scripts/check.php",
    "test": "phpunit"
    }
}